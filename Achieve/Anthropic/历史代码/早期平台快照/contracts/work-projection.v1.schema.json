{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jianwei.local/contracts/work-projection.v1.schema.json",
  "title": "见微 WorkProjection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "fixture", "dataOrigin", "projectionIdentity",
    "projectionVersion", "eventCursor", "generatedAt", "scenario",
    "currentActorId", "work", "actors", "relations", "stages", "matrix",
    "signals", "activities", "availableCommands"
  ],
  "properties": {
    "schemaVersion": { "const": "work-projection.v1" },
    "fixture": { "const": false },
    "dataOrigin": { "enum": ["sample", "user", "connector"] },
    "projectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "workId"],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/id" },
        "workId": { "$ref": "#/$defs/id" }
      }
    },
    "projectionVersion": { "type": "integer", "minimum": 0 },
    "eventCursor": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "defaultView"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/scenarioName" },
        "defaultView": { "$ref": "#/$defs/view" }
      }
    },
    "currentActorId": { "$ref": "#/$defs/id" },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "goalVersion", "stageId", "status", "ownerActorId", "nextStep", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "goalVersion": { "type": "integer", "minimum": 1 },
        "stageId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "blocked", "awaiting_gate", "completed", "cancelled"] },
        "ownerActorId": { "$ref": "#/$defs/id" },
        "nextStep": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "matrix": { "$ref": "#/$defs/matrix" },
    "signals": { "$ref": "#/$defs/signals" },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "availableCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/availableCommand" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "view": { "enum": ["relation", "progress", "matrix"] },
    "scenarioName": {
      "enum": [
        "风控业务协同", "需求开发协同", "人机交互协同", "内容生产协同", "经营增长协同",
        "物理智能协同", "知识办公协同", "客户服务协同", "供应链履约协同", "医疗服务协同"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "role", "authority", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "type": { "enum": ["human", "agent", "system"] },
        "role": { "$ref": "#/$defs/text" },
        "authority": { "enum": ["none", "observe", "propose", "own", "approve", "authorize", "receipt-only"] },
        "state": { "type": "string", "maxLength": 500 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["actor", "work", "stage"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "state", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" },
        "type": { "enum": ["owns", "assists", "reviews", "hands_off", "invokes", "receives"] },
        "state": { "enum": ["active", "pending", "accepted", "rejected", "completed"] },
        "label": { "type": "string", "maxLength": 500 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "state", "detail", "responsibleActorIds", "blockers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "order": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["done", "current", "pending", "blocked"] },
        "detail": { "type": "string", "maxLength": 2000 },
        "responsibleActorIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "blockers": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnId", "responsibility", "state", "label"],
      "properties": {
        "columnId": { "$ref": "#/$defs/id" },
        "responsibility": { "enum": ["none", "observe", "assist", "prepare", "review", "challenge", "own", "approve", "authorize", "receipt-only"] },
        "state": { "enum": ["none", "pending", "active", "done", "blocked", "unknown"] },
        "label": { "type": "string", "maxLength": 500 }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnKind", "columns", "rows"],
      "properties": {
        "columnKind": { "const": "stage" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/text" }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actorId", "cells"],
            "properties": {
              "actorId": { "$ref": "#/$defs/id" },
              "cells": { "type": "array", "items": { "$ref": "#/$defs/matrixCell" } }
            }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "raisedByActorId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "state": { "enum": ["open", "resolved", "dismissed"] },
        "raisedByActorId": { "$ref": "#/$defs/id" }
      }
    },
    "gate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "state", "basis", "impact", "responsibleActorId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["pending", "approved", "rejected", "needs_evidence"] },
        "basis": { "$ref": "#/$defs/text" },
        "impact": { "$ref": "#/$defs/text" },
        "responsibleActorId": { "$ref": "#/$defs/id" }
      }
    },
    "actionIntent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "state", "actionType", "targetActorId", "authorizedByActorId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["created", "dispatched", "finished"] },
        "actionType": { "$ref": "#/$defs/id" },
        "targetActorId": { "$ref": "#/$defs/id" },
        "authorizedByActorId": { "$ref": "#/$defs/id" }
      }
    },
    "receipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "actionIntentId", "status", "recordedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actionIntentId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["succeeded", "failed", "unknown"] },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenges", "gate", "actionIntent", "receipt"],
      "properties": {
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/challenge" } },
        "gate": { "$ref": "#/$defs/gate" },
        "actionIntent": { "$ref": "#/$defs/actionIntent" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["global", "work", "actor", "stage", "challenge", "gate", "action", "receipt"] },
        "id": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "occurredAt", "actorId", "title", "body", "scope", "authoritative", "receiptStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["message", "artifact", "challenge", "handoff", "gate", "action", "receipt", "system"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "actorId": { "type": ["string", "null"], "maxLength": 128 },
        "title": { "$ref": "#/$defs/text" },
        "body": { "type": "string", "maxLength": 4000 },
        "scope": { "$ref": "#/$defs/scope" },
        "authoritative": { "type": "boolean" },
        "receiptStatus": { "type": ["string", "null"], "enum": ["succeeded", "failed", "unknown", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "message" } }, "required": ["type"] },
          "then": { "properties": { "authoritative": { "const": false } } }
        },
        {
          "if": { "properties": { "type": { "const": "receipt" } }, "required": ["type"] },
          "then": { "properties": { "receiptStatus": { "enum": ["succeeded", "failed", "unknown"] } } }
        }
      ]
    },
    "availableCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "requiresConfirmation"],
      "properties": {
        "type": {
          "enum": [
            "append_message", "update_goal", "request_agent_run", "raise_challenge", "resolve_challenge",
            "propose_handoff", "accept_handoff", "decide_gate", "create_action_intent", "record_receipt"
          ]
        },
        "label": { "$ref": "#/$defs/text" },
        "requiresConfirmation": { "type": "boolean" }
      }
    }
  }
}
