{
  "_comment": "V7 backend-next B 配置示例。复制为 b-config.json 后按需修改。transport.real.apiKey 只能显式写在这里(或经 API 注入);B 绝不从环境读取真实密钥。未配置 transport.mode = not_configured(如实状态,不静默 mock)。worker.taskTimeoutMs 必须小于 A 的租约时长(当前 90s),否则写回会被 LEASE_EXPIRED 拒绝。",
  "transport": {
    "mode": "mock",
    "mock": { "baseUrl": "http://127.0.0.1:3730", "timeoutMs": 8000, "model": "mock-glm-5.2" },
    "real": {
      "_comment": "GLM-5.2 预留:OpenAI 兼容 /chat/completions;endpoint 必须在 outboundAllow 内;本轮 0 真实调用",
      "endpoint": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "model": "GLM-5.2",
      "apiKey": "<显式注入,留空=未配置>",
      "timeoutMs": 30000,
      "outboundAllow": ["https://open.bigmodel.cn"],
      "cost": { "per1kInput": null, "per1kOutput": null, "currency": "CNY" }
    }
  },
  "routes": {
    "_comment": "规则限定可信路由:首中即用;plan 为线性执行计划(前序=数组前项);role 必须在 roles 清单",
    "roles": ["policy", "credit", "risk", "asset", "commerce", "seekeeper"],
    "rules": [
      {
        "ruleId": "R-CREDIT-REVIEW",
        "when": { "taskKind": "model_review", "role": "credit" },
        "plan": [
          { "stepId": "model:credit:risk_review", "kind": "model", "role": "credit", "purpose": "risk_review" }
        ]
      },
      {
        "ruleId": "R-POLICY-CHECK",
        "when": { "taskKind": "model_review", "role": "policy" },
        "plan": [
          { "stepId": "model:policy:policy_check", "kind": "model", "role": "policy", "purpose": "policy_check" }
        ]
      },
      {
        "ruleId": "R-REVIEW-PLUS-CALC",
        "when": { "taskKind": "review_with_calc" },
        "plan": [
          { "stepId": "model:credit:risk_review", "kind": "model", "role": "credit", "purpose": "risk_review" },
          { "stepId": "tool:calc:cash-flow-coverage", "kind": "tool", "toolName": "calc:cash-flow-coverage" }
        ]
      },
      {
        "ruleId": "R-CALC-ONLY",
        "when": { "taskKind": "cash_flow_coverage" },
        "plan": [
          { "stepId": "tool:calc:cash-flow-coverage", "kind": "tool", "toolName": "calc:cash-flow-coverage" }
        ]
      }
    ]
  },
  "budget": { "maxTotalCost": 0.5, "perCallEstimate": 0.01, "currency": "CNY" },
  "_budget_comment": "D-25 预算上限(可选):mock/real 同一记账面,cost-ledger.jsonl 持久累计,重启/并发不绕过;超限=确定未发送失败关闭。删除本段=不启用。",
  "contract": {
    "_comment": "stub=B 本地测试替身;http=A 真实契约(需 principalCredential,如 A 发布的 tok-agent)",
    "mode": "stub",
    "baseUrl": "http://127.0.0.1:48080",
    "principalCredential": "tok-agent"
  },
  "worker": {
    "workerId": "b-worker-1",
    "concurrency": 2,
    "pollIntervalMs": 500,
    "taskTimeoutMs": 60000,
    "maxReclaims": 1
  }
}
