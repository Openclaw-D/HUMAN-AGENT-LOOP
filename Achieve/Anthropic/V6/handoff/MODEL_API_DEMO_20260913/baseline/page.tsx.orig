"use client";

// V6 SE_REBUILD · 业务↔实控人访谈 · 第三版连续面板视觉（sub-agent B 写面）。
// 布局：精简顶部（返回+阶段徽章+当前问题简题）→ 连续面板主内容（内部滚动，4px分隔带）
// → 底部常驻输入与操作区（补证输入/暂停/恢复/转人工，hit area≥44px）。
// 无视频时直接呈现可用的文字访谈：视频状态压缩为紧凑行如实展示，不穿过大面积假画面。
// 底线不变：视频/语音未接入如实显示；模型输出显式 SIMULATION、authority=none；
// 全部写请求走不可变原请求注册（发送前落盘、同载荷原样重试）；暂停为服务端执行门；
// "返回项目"=导航（Link 到 /v5-preview），不冒称结束通话。
import { useCallback, useEffect, useRef, useState } from 'react';
import Link from 'next/link';
import CameraPanel from './camera-panel';
import { RequestRegistry, type RegistryEntry } from '../../../lib/v5-preview/remote-request-registry';
import { CheckIcon, ClockIcon, CrossIcon, GearIcon, MagnifierIcon, WarnIcon } from '../se-icons';
import styles from './se-interview.module.css';

// ---------------------------------------------------------------------------
// API 客户端 + F1 不可变请求注册（沿用返修版语义）
// ---------------------------------------------------------------------------

interface RemoteApiFailure extends Error {
  code: string;
  serverVersion?: number;
}

function toFailure(payload: unknown, status: number): RemoteApiFailure {
  const o = (payload && typeof payload === 'object' ? payload : {}) as Record<string, unknown>;
  const err = new Error(typeof o.message === 'string' ? o.message : `请求失败（HTTP ${status}）`) as RemoteApiFailure;
  err.code = typeof o.error === 'string' ? o.error : `HTTP_${status}`;
  if (typeof o.serverVersion === 'number') err.serverVersion = o.serverVersion;
  return err;
}

async function postRemote(path: string, body: Record<string, unknown>): Promise<Record<string, unknown>> {
  let response: Response;
  try {
    response = await fetch(`/api/v5-preview/remote-session/${path}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
  } catch {
    throw toFailure({ error: 'NETWORK', message: '网络异常：未收到服务端确认' }, 0);
  }
  const payload = await response.json().catch(() => null);
  if (!response.ok) throw toFailure(payload, response.status);
  return (payload ?? {}) as Record<string, unknown>;
}

async function getRemote<T>(path: string): Promise<T> {
  const response = await fetch(`/api/v5-preview/remote-session/${path}`, { cache: 'no-store' });
  const payload = await response.json().catch(() => null);
  if (!response.ok) throw toFailure(payload, response.status);
  return (payload ?? {}) as T;
}

function newRequestId(): string {
  if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') return crypto.randomUUID();
  return `req-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
}

function userFacing(code: string, message: string | undefined): string {
  if (code === 'NETWORK') return '网络异常：未收到服务端确认，可原样重试（同一请求）';
  if (code === 'VERSION_CONFLICT') return '状态已被其他窗口更新，请重试（内容已保留）';
  if (code === 'SESSION_PAUSED') return '本轮判断已暂停：该操作被服务端阻断（补证/纠正类仍可用）';
  if (code === 'REQUEST_MISMATCH') return '请求状态不一致，请刷新后重试';
  if (code === 'NOT_FOUND') return '目标不存在（跨会话/跨项目资源不可访问）';
  if (code === 'INVALID_INPUT') return message ?? '输入不符合要求，请检查后重试';
  if (code === 'REMOTE_STORE_CORRUPT' || code === 'REMOTE_STORE_UNAVAILABLE') return '远程尽调数据暂不可用，请稍后重试';
  return message ?? '服务暂不可用，请稍后重试';
}

// R2：多请求注册表（sessionStorage 持久化，不可用时退化内存）——
// 多条未知请求并存不覆盖；同 op 同载荷原样重试复用冻结 requestId；草稿关联 requestId+修订。
const registry = new RequestRegistry({
  storage: {
    get: () => {
      try { return window.sessionStorage.getItem('jw:v5-preview:remote-request-registry'); } catch { return null; }
    },
    set: (value: string) => {
      try { window.sessionStorage.setItem('jw:v5-preview:remote-request-registry', value); } catch { /* 不可用：退化内存 */ }
    },
    remove: () => {
      try { window.sessionStorage.removeItem('jw:v5-preview:remote-request-registry'); } catch { /* 忽略 */ }
    },
  },
});

function refreshUnknowns(sessionId: string): RegistryEntry[] {
  return registry.listUnknown(sessionId);
}

// ---------------------------------------------------------------------------
// 类型
// ---------------------------------------------------------------------------

interface SessionDetail {
  ok: boolean;
  remoteVersion: number;
  session: {
    sessionId: string; projectId: string; title: string; status: string; generation: number;
    participants: { participantId: string; displayName: string; kind: string; domainRole: string; attendance: string; attendanceVerified: boolean; joined: boolean }[];
    video: { provider: string; state: string; message: string };
  };
  evidence: { evidenceId: string; fixtureId: string; title: string; version: number; verificationStatus: string; expired: boolean; sha256: string; digestOf?: string; supersededBy: string | null; capturedAt: string }[];
  annotations: { annotationId: string; evidenceId: string; evidenceVersion: number; rect: { x: number; y: number; w: number; h: number }; question: string; author: string; status: string; version: number; expired?: boolean; replies: { replyId: string; kind: string; author: string; text: string; at: string }[] }[];
  reviews: { reviewId: string; targetType: string; targetId: string; targetVersion: number; action: string; opinion: string; reviewer: string; at: string }[];
  calculations: { calcId: string; status: string; stale?: boolean; reasons: string[]; inputs: { label: string; value: number | null; unit: string; source: string }[]; result: { kind: string }; at: string }[];
  ruleConfig: { status: string; layers: Record<string, unknown> };
}

const VOICE_NOTE_NO_API = '语音输入未接入：当前环境无浏览器语音识别接口，产品也未集成 ASR 服务。可先用下方文字输入（语音接口已冻结，接入另行授权）。';
const VOICE_NOTE_API_PRESENT = '浏览器具备语音识别接口（Web Speech），但产品尚未接入：为不以未验证能力冒充已支持，语音录入暂不可用，请先用文字输入。';

// ---------------------------------------------------------------------------
// 本页内联细线图标（se-icons 未导出、不新增导出；视觉规范同 se-icons：24 viewBox/1.8 描边）
// ---------------------------------------------------------------------------

function iconBase(size: number | undefined, className: string | undefined) {
  return {
    width: size ?? 16,
    height: size ?? 16,
    viewBox: '0 0 24 24',
    fill: 'none',
    stroke: 'currentColor',
    strokeWidth: 1.8,
    strokeLinecap: 'round' as const,
    strokeLinejoin: 'round' as const,
    'aria-hidden': true,
    className,
  };
}

function ArrowLeftIcon({ size, className }: { size?: number; className?: string }) {
  return (
    <svg {...iconBase(size, className)}>
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
  );
}

function ChevronRightIcon({ size, className }: { size?: number; className?: string }) {
  return (
    <svg {...iconBase(size, className)}>
      <path d="m9.5 5.5 6.5 6.5-6.5 6.5" />
    </svg>
  );
}

function CameraLineIcon({ size, className }: { size?: number; className?: string }) {
  return (
    <svg {...iconBase(size, className)}>
      <path d="M8.5 7 10 4.5h4L15.5 7" />
      <rect x="3.5" y="7" width="17" height="12.5" rx="2" />
      <circle cx="12" cy="13.2" r="3.2" />
    </svg>
  );
}

function MicLineIcon({ size, className }: { size?: number; className?: string }) {
  return (
    <svg {...iconBase(size, className)}>
      <rect x="9.5" y="3.5" width="5" height="10" rx="2.5" />
      <path d="M6.5 11.5a5.5 5.5 0 0 0 11 0M12 17v3.5" />
    </svg>
  );
}

export default function RemoteSessionPage() {
  const [phase, setPhase] = useState<'loading' | 'empty' | 'ready' | 'error'>('loading');
  const [detail, setDetail] = useState<SessionDetail | null>(null);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [remoteVersion, setRemoteVersion] = useState(0);
  const [busy, setBusy] = useState(false);
  const [notice, setNotice] = useState<string | null>(null);
  const [writeError, setWriteError] = useState<string | null>(null);
  const [unknowns, setUnknowns] = useState<RegistryEntry[]>([]);
  const [simulationOn, setSimulationOn] = useState(false);
  const [activeEvidenceId, setActiveEvidenceId] = useState<string | null>(null);
  const [answer, setAnswer] = useState(() => {
    try { return window.sessionStorage.getItem('jw:v5-preview:draft:answer') ?? ''; } catch { return ''; }
  });
  const [voiceOpen, setVoiceOpen] = useState(false);
  const [fields, setFields] = useState({ deviceCount: '', quote: '' });
  const [voiceCaps, setVoiceCaps] = useState<'unknown' | 'no_api' | 'api_present'>('unknown');
  const [calcResult, setCalcResult] = useState<SessionDetail['calculations'] | null>(null);
  const [showTech, setShowTech] = useState(false);
  const [askDraft, setAskDraft] = useState(() => {
    try { return window.sessionStorage.getItem('jw:v5-preview:draft:ask') ?? ''; } catch { return ''; }
  });
  const [fullscreen, setFullscreen] = useState(false); // 访谈全屏覆盖层（同一页面内，非新路由）
  const [flipNote, setFlipNote] = useState<string | null>(null);
  const [transcript, setTranscript] = useState<{ at: string; who: string; text: string }[]>([]); // 合成转写事件（非真实 ASR）
  const transcriptSeq = useRef(0);
  const askPendingRef = useRef(false);
  const answerRevisionRef = useRef(0);
  const draftAssocRef = useRef<{ requestId: string; revision: number } | null>(null);

  const session = detail?.session ?? null;
  const paused = session?.status === 'paused';
  const activeQuestion = detail?.annotations.find((a) => !a.expired && a.status === 'open') ?? null;
  const openCount = detail?.annotations.filter((a) => !a.expired && a.status === 'open').length ?? 0;

  const loadDetail = useCallback(async (sessionId: string): Promise<void> => {
    const data = await getRemote<SessionDetail>(`detail?sessionId=${encodeURIComponent(sessionId)}`);
    setDetail(data);
    setRemoteVersion(data.remoteVersion);
    setPhase('ready');
    // R2：会话确定后按真实 owner 刷新未知请求恢复条（挂载时 owner 为空查不到会话内记录）。
    setUnknowns(registry.listUnknown(sessionId));
  }, []);

  const loadState = useCallback(async (): Promise<void> => {
    const data = await getRemote<{ remoteVersion: number; sessions: { sessionId: string }[] }>('');
    setRemoteVersion(data.remoteVersion);
    const existing = data.sessions[0];
    if (existing === undefined) {
      setPhase('empty');
      return;
    }
    await loadDetail(existing.sessionId);
  }, [loadDetail]);

  useEffect(() => {
    const timer = window.setTimeout(() => {
      setUnknowns(refreshUnknowns(''));
      loadState().catch((e) => {
        setPhase('error');
        setLoadError(typeof (e as RemoteApiFailure).code === 'string' ? userFacing((e as RemoteApiFailure).code, (e as RemoteApiFailure).message) : '服务暂不可用');
      });
    }, 0);
    return () => window.clearTimeout(timer);
  }, [loadState]);

  /** F1：不可变原请求写路径（同载荷原样重试；发送前落盘；确定性结果清记录）。 */
  const runWrite = useCallback(async (path: string, body: Record<string, unknown>, op: string, done: (data: Record<string, unknown>) => void, sessionId: string, draftRevision: number | null = null) => {
    setBusy(true);
    setNotice(null);
    setWriteError(null);
    // R2：原样重试查找（同 op 同载荷同会话的 unknown 记录 → 复用冻结 requestId/载荷）。
    const retryEntry = registry.findRetry(op, { ...body, sessionId }, sessionId);
    const requestId = retryEntry !== null ? retryEntry.requestId : newRequestId();
    const fullBody = retryEntry !== null ? { ...retryEntry.body, sessionId } : { ...body, requestId, sessionId };
    if (retryEntry === null) {
      const began = registry.begin({ op, path, body: fullBody, ownerSessionId: sessionId, draftRevision: op === 'reply-annotation' ? draftRevision : null });
      if (!began.ok) {
        setBusy(false);
        setWriteError(`存在 ${began.unknownCount} 条未确认请求已达演示上限：请先原样重试或放弃（在途请求不被覆盖）。`);
        return;
      }
    }
    if (op === 'reply-annotation' && draftRevision !== null) draftAssocRef.current = { requestId, revision: draftRevision };
    try {
      const data = await postRemote(path, fullBody);
      registry.resolve(requestId, 'confirmed');
      setUnknowns(registry.listUnknown(sessionId));
      if (op === 'reply-annotation') {
        const assoc = draftAssocRef.current;
        if (assoc !== null && assoc.requestId === requestId && assoc.revision === draftRevision && answerRevisionRef.current === draftRevision) {
          setAnswer('');
          answerRevisionRef.current = 0;
          draftAssocRef.current = null;
          try { window.sessionStorage.removeItem('jw:v5-preview:draft:answer'); } catch { /* 忽略 */ }
        }
      }
      if (typeof data.remoteVersion === 'number') setRemoteVersion(data.remoteVersion);
      done(data);
      if (session !== null && sessionId === session.sessionId) await loadDetail(sessionId).catch(() => undefined);
    } catch (e) {
      const f = e as RemoteApiFailure;
      if (f.code === 'NETWORK') {
        setUnknowns(registry.listUnknown(sessionId));
        setNotice('网络异常：未收到服务端确认。可点击「原样重试」（同一请求，幂等安全）或「放弃该请求」。');
      } else {
        registry.resolve(requestId, 'dropped');
        setUnknowns(registry.listUnknown(sessionId));
        setWriteError(userFacing(f.code, f.message));
        if (f.code === 'VERSION_CONFLICT') {
          if (session !== null && sessionId === session.sessionId) await loadDetail(sessionId).catch(() => undefined);
          else await loadState().catch(() => undefined);
        }
      }
    } finally {
      setBusy(false);
    }
  }, [loadDetail, loadState, session]);

  const retryPending = useCallback(async (requestId: string): Promise<void> => {
    const record = registry.getByRequest(requestId);
    if (record === null) { setUnknowns(registry.listUnknown(session?.sessionId ?? '')); return; }
    if (session === null || record.ownerSessionId !== session.sessionId) {
      setNotice('该未知请求属于其他会话或会话已变化：请先「放弃该请求」或返回对应会话处理。');
      return;
    }
    await runWrite(record.path, record.body, record.op, () => setNotice('原样重试成功：同一请求已确认。'), record.ownerSessionId, record.draftRevision);
  }, [runWrite, session]);

  function discardPendingById(requestId: string): void {
    registry.abandon(requestId);
    setUnknowns(registry.listUnknown(session?.sessionId ?? ''));
    setNotice('已放弃该未知请求（不产生任何写入）。');
  }

  async function createSession(): Promise<void> {
    await runWrite('', { title: 'JW-2026-018 · 远程尽调访谈（合成演示）', expectedVersion: remoteVersion }, 'create-session', (data) => {
      const created = data.session as SessionDetail['session'];
      if (created !== undefined) void loadDetail(created.sessionId);
    }, '');
  }

  /** 提交访谈记录：回答当前关键问题（业务身份），附关键字段人工核对值。 */
  function submitInterviewRecord(): void {
    if (session === null || activeQuestion === null || answer.trim() === '') return;
    const revision = answerRevisionRef.current;
    const fieldNote = fields.deviceCount.trim() !== '' || fields.quote.trim() !== ''
      ? `（人工核对字段：设备数量 ${fields.deviceCount.trim() || '—'} 台；报价 ${fields.quote.trim() || '—'} 万元）`
      : '';
    void runWrite('annotations/replies', {
      annotationId: activeQuestion.annotationId,
      kind: 'business',
      text: `${answer.trim()}${fieldNote}`,
      expectedVersion: remoteVersion,
    }, 'reply-annotation', () => setNotice('访谈记录已提交（合成演示）'), session.sessionId, revision);
  }

  function pauseRound(): void {
    if (session === null || activeQuestion === null) return;
    void runWrite('reviews', {
      targetType: 'annotation',
      targetId: activeQuestion.annotationId,
      targetVersion: activeQuestion.version,
      action: 'pause_round',
      opinion: reviewDraftOpinion(),
      expectedVersion: remoteVersion,
    }, 'create-review', () => setNotice('本轮判断已暂停（服务端已阻断模型/确认类动作）'), session.sessionId);
  }

  /** 恢复本轮（显式）：仅会话处于暂停时可用；与暂停同为服务端复核动作，失败如实反馈。 */
  function resumeRound(): void {
    if (session === null || activeQuestion === null) return;
    void runWrite('reviews', {
      targetType: 'annotation',
      targetId: activeQuestion.annotationId,
      targetVersion: activeQuestion.version,
      action: 'resume_round',
      opinion: '演示恢复（合成）',
      expectedVersion: remoteVersion,
    }, 'create-review', () => setNotice('已显式恢复本轮'), session.sessionId);
  }

  /** 转人工（escalate_human）：走同一人工复核写路径；暂停中被服务端阻断（按钮同时置灰并说明）。 */
  function escalateHuman(): void {
    if (session === null || activeQuestion === null) return;
    void runWrite('reviews', {
      targetType: 'annotation',
      targetId: activeQuestion.annotationId,
      targetVersion: activeQuestion.version,
      action: 'escalate_human',
      opinion: '关键问题转人工处理（合成演示）',
      expectedVersion: remoteVersion,
    }, 'create-review', () => setNotice('已提交转人工复核（合成演示；模型无审批权）'), session.sessionId);
  }

  function reviewDraftOpinion(): string {
    return '本轮判断暂停（关键问题待闭环，合成演示）';
  }

  /** 语音能力如实检测：仅在用户点击语音按钮时执行；不申请麦克风权限。 */
  function openVoicePanel(): void {
    setVoiceOpen(true);
    if (voiceCaps === 'unknown') {
      const hasApi = typeof window !== 'undefined' && ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window);
      setVoiceCaps(hasApi ? 'api_present' : 'no_api');
    }
  }

  if (phase === 'loading' || phase === 'error') {
    return (
      <div className={styles.seInterviewRoot}>
        <header className={styles.sivTop}>
          <Link className={styles.sivTopBack} href="/v5-preview" aria-label="返回项目总览"><ArrowLeftIcon size={18} /></Link>
          <b className={styles.sivTopTitle}>远程尽调访谈</b>
          <span className={styles.sivTopChip} data-state={phase === 'error' ? 'error' : 'loading'}>{phase === 'error' ? '加载失败' : '加载中'}</span>
        </header>
        <div className={styles.sivScroll}>
          <div className={styles.sivPanel}>
            <section className={styles.sivSection} role={phase === 'error' ? 'alert' : 'status'}>
              <p className={styles.sivQ}>{phase === 'error' ? `加载失败：${loadError ?? '未知错误'}` : '正在加载访谈会话（合成演示）…'}</p>
              {phase === 'error'
                ? (
                    <div className={styles.sivBtnRow}>
                      <button type="button" className={styles.sivPrimary} onClick={() => { setPhase('loading'); void loadState(); }}>重试</button>
                    </div>
                  )
                : null}
            </section>
          </div>
        </div>
      </div>
    );
  }

  if (phase === 'empty') {
    return (
      <div className={styles.seInterviewRoot}>
        <header className={styles.sivTop}>
          <Link className={styles.sivTopBack} href="/v5-preview" aria-label="返回项目总览"><ArrowLeftIcon size={18} /></Link>
          <b className={styles.sivTopTitle}>远程尽调访谈</b>
          <span className={styles.sivTopChip} data-state="empty">未开始</span>
        </header>
        <div className={styles.sivScroll}>
          <div className={styles.sivPanel}>
            <section className={styles.sivSection}>
              <p className={styles.sivQ}>尚无访谈会话</p>
              <p className={styles.sivNote}>创建后：业务与实控人围绕关键问题访谈；证据用显著标记的合成图形；视频/语音未接入会如实显示。</p>
              {writeError !== null ? <p className={styles.sivError} role="alert">{writeError}</p> : null}
              {unknowns.map((u) => (
                <div key={u.requestId} className={styles.sivPendingBar} role="status">
                  <span>有一条未确认请求（{u.op}）。</span>
                  <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => { void retryPending(u.requestId); }}>原样重试</button>
                  <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => discardPendingById(u.requestId)}>放弃</button>
                </div>
              ))}
              <div className={styles.sivBtnRow}>
                <button type="button" className={styles.sivPrimary} disabled={busy} onClick={() => { void createSession(); }}>开始访谈会话</button>
              </div>
              {notice !== null ? <p className={styles.sivNotice} role="status">{notice}</p> : null}
            </section>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className={styles.seInterviewRoot}>
      <header className={styles.sivTop}>
        <Link className={styles.sivTopBack} href="/v5-preview" aria-label="返回项目总览（状态与草稿保留）"><ArrowLeftIcon size={18} /></Link>
        <span className={styles.sivTopChip} data-state={paused ? 'paused' : 'live'}>
          {paused ? <WarnIcon size={13} className={styles.sivChipIcon} /> : <span className={styles.sivDot} aria-hidden="true" />}
          {paused ? '已暂停' : '进行中'}
        </span>
        <b className={styles.sivTopTitle}>{activeQuestion !== null ? activeQuestion.question : '当前待办：补充设备清单'}</b>
      </header>

      {unknowns.length > 0 ? (
        <div className={styles.sivStatusStrip}>
          {unknowns.map((u) => (
            <div key={u.requestId} className={styles.sivPendingBar} role="status">
              <span>有一条请求结果未知（{u.op}，发送于 {new Date(u.savedAt).toLocaleTimeString()}）。</span>
              <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => { void retryPending(u.requestId); }}>原样重试</button>
              <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => discardPendingById(u.requestId)}>放弃</button>
            </div>
          ))}
        </div>
      ) : null}

      {/* 主内容：一块连续面板、内部滚动、4px 分隔带 */}
      <div className={styles.sivScroll}>
        <div className={styles.sivPanel}>
          {/* 当前关键问题（首屏主体，不穿过假画面） */}
          <section className={styles.sivSection} aria-label="当前关键问题">
            <p className={styles.sivSecKicker}>
              远程尽调 · {detail?.session.projectId} · 当前关键问题 · 轮到{activeQuestion ? '实控人回答' : '业务发起'}
              {openCount > 1 ? `（另有 ${openCount - 1} 个待办问题）` : ''}
            </p>
            {activeQuestion !== null ? (
              <>
                <p className={styles.sivQ}>{activeQuestion.question}</p>
                <p className={styles.sivBasis}>
                  依据：现场证据 v{activeQuestion.evidenceVersion}
                  {(() => {
                    const ev = detail?.evidence.find((e) => e.evidenceId === activeQuestion.evidenceId);
                    return ev !== undefined ? ` · ${ev.verificationStatus === 'human_verified' ? '已人工核实' : ev.verificationStatus === 'contested' ? '有争议' : '未核实'}` : '';
                  })()}
                </p>
                <p className={styles.sivRisk}>风险提示：设备清单尚未补齐，相关判断处于待核实状态（不因资料增加自动放行）。</p>
              </>
            ) : (
              <>
                <p className={styles.sivQ}>当前待办：补充设备清单，请实控人现场说明设备现状。</p>
                <p className={styles.sivBasis}>依据：信审待补充（合成演示状态）。</p>
                <p className={styles.sivRisk}>风险提示：关键资料未到位前，不做额度/价格结论。</p>
              </>
            )}
          </section>

          {/* 视频/连接状态：紧凑行如实展示（未接入/未配置；不放大面积模拟画面） */}
          <section className={styles.sivSection} aria-label="视频与连接状态">
            <div className={styles.sivRowLine}>
              <CameraLineIcon size={16} className={styles.sivMutedIcon} />
              <span className={styles.sivLineTxt}>连接状态：未接入（不申请摄像头/麦克风，不采集）</span>
              <span className={styles.sivStateBadge} data-state="bad"><CrossIcon size={13} />未配置</span>
            </div>
            <label className={styles.sivToggle}>
              <input type="checkbox" checked={simulationOn} onChange={(e) => setSimulationOn(e.target.checked)} />
              模拟画面开关（仅全屏模拟视图内生效，非真实画面）
            </label>
          </section>

          {/* 语音说明（点开后按需呈现；能力如实检测，不申请麦克风） */}
          {voiceOpen ? (
            <section className={styles.sivSection} role="status" aria-label="语音输入说明">
              <p className={styles.sivNote}>{voiceCaps === 'no_api' ? VOICE_NOTE_NO_API : voiceCaps === 'api_present' ? VOICE_NOTE_API_PRESENT : '正在检测语音能力…'}</p>
              <p className={styles.sivNote}>语音接口已冻结：接入需媒体权限与 ASR 服务授权（另行 Gate），不以普通文本框冒称已支持语音。</p>
              <div className={styles.sivBtnRow}>
                <button type="button" className={styles.sivBtnSmall} onClick={() => setFullscreen(true)}>
                  进入全屏访谈（模拟画面 · 转写演示）
                </button>
                <button
                  type="button"
                  className={styles.sivBtnSmall}
                  onClick={() => {
                    transcriptSeq.current += 1;
                    const n = transcriptSeq.current;
                    setTranscript((prev) => [...prev, {
                      at: new Date().toLocaleTimeString('zh-CN', { hour12: false }),
                      who: n % 2 === 1 ? '实控人（合成）' : '业务（合成）',
                      text: n % 2 === 1 ? `（合成转写事件 ${n}）设备运行正常，共三台。` : `（合成转写事件 ${n}）追问：检修计划请书面确认。`,
                    }]);
                  }}
                >
                  添加合成转写事件（演示 · 非真实 ASR）
                </button>
              </div>
            </section>
          ) : null}

          {/* 证据入口（折叠）：附着合成证据 + 证据清单 + 本地拍照 */}
          <details
            className={styles.sivDetails}
            onToggle={(e) => { if ((e.target as HTMLDetailsElement).open && activeEvidenceId === null && (detail?.evidence.length ?? 0) > 0) setActiveEvidenceId(detail!.evidence[0].evidenceId); }}
          >
            <summary>
              <MagnifierIcon size={16} className={styles.sivSummaryLead} />
              <span className={styles.sivSummaryTxt}>证据（{detail?.evidence.length ?? 0}）与本地拍照</span>
              <ChevronRightIcon size={16} className={styles.sivChevron} />
            </summary>
            <div className={styles.sivDetailsBody}>
              <div className={styles.sivBtnRow}>
                <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => { void runWrite('evidence', { fixtureId: 'fixture-inspection', expectedVersion: remoteVersion }, 'attach-evidence', () => setNotice('证据已附着（合成）'), session?.sessionId ?? ''); }}>
                  附着现场巡检（合成）
                </button>
                <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => { void runWrite('evidence', { fixtureId: 'fixture-equipment', expectedVersion: remoteVersion }, 'attach-evidence', () => setNotice('证据已附着（合成）'), session?.sessionId ?? ''); }}>
                  附着设备清单（合成）
                </button>
              </div>
              <ul className={styles.sivEvidenceList}>
                {(detail?.evidence ?? []).map((e) => (
                  <li key={e.evidenceId} className={styles.sivEvidenceItem} data-active={e.evidenceId === activeEvidenceId ? 'yes' : 'no'}>
                    <button type="button" className={styles.sivEvidenceBtn} onClick={() => setActiveEvidenceId(e.evidenceId)}>
                      {e.title}
                    </button>
                    <span className={styles.sivStateBadge} data-state={e.verificationStatus === 'human_verified' ? 'ok' : e.verificationStatus === 'contested' ? 'warn' : 'idle'}>
                      {e.verificationStatus === 'human_verified' ? <CheckIcon size={13} /> : e.verificationStatus === 'contested' ? <WarnIcon size={13} /> : <ClockIcon size={13} />}
                      {e.verificationStatus === 'human_verified' ? '已核实' : e.verificationStatus === 'contested' ? '有争议' : '未核实'}
                    </span>
                    {e.expired ? <span className={styles.sivStateBadge} data-state="bad"><CrossIcon size={13} />已过期</span> : null}
                  </li>
                ))}
                {(detail?.evidence.length ?? 0) === 0 ? <li className={styles.sivNote}>尚无证据。</li> : null}
              </ul>
              <CameraPanel />
            </div>
          </details>

          {/* 项目沟通与历史问答（折叠）：回复角色如实标注（模型=模拟） */}
          <details className={styles.sivDetails}>
            <summary>
              <GearIcon size={16} className={styles.sivSummaryLead} />
              <span className={styles.sivSummaryTxt}>项目沟通与历史问答（{detail?.annotations.length ?? 0} 问）</span>
              <ChevronRightIcon size={16} className={styles.sivChevron} />
            </summary>
            <div className={styles.sivDetailsBody}>
              <ul className={styles.sivAnnotations}>
                {(detail?.annotations ?? []).map((a) => (
                  <li key={a.annotationId} className={styles.sivAnnotation} data-expired={a.expired ? 'yes' : 'no'}>
                    <p className={styles.sivQuestion}>【证据 v{a.evidenceVersion}{a.expired ? ' · 证据已过期' : ''}】{a.question}</p>
                    {a.replies.map((r) => (
                      <p key={r.replyId} className={styles.sivReply} data-kind={r.kind}>
                        <span className={styles.sivReplyKind}>{r.kind === 'model_simulation' ? '模型（模拟）' : r.kind === 'business' ? '业务' : '专业域'}</span>
                        <span>{r.text}</span>
                      </p>
                    ))}
                    <div className={styles.sivBtnRow}>
                      <button
                        type="button"
                        className={styles.sivBtnSmall}
                        disabled={busy || paused}
                        title={paused ? '本轮判断已暂停：模型推进被服务端阻断' : undefined}
                        onClick={() => { void runWrite('annotations/simulate', { annotationId: a.annotationId, expectedVersion: remoteVersion }, 'simulate-followups', () => setNotice('模拟追问已生成（SIMULATION）'), session?.sessionId ?? ''); }}
                      >
                        模拟追问（SIMULATION）
                      </button>
                    </div>
                  </li>
                ))}
                {(detail?.annotations.length ?? 0) === 0 ? <li className={styles.sivNote}>暂无历史问答。</li> : null}
              </ul>
            </div>
          </details>

          {/* 演示设置（折叠：技术 ID/调试/演示控制） */}
          <details className={styles.sivDetails} open={showTech} onToggle={(e) => setShowTech((e.target as HTMLDetailsElement).open)}>
            <summary>
              <ClockIcon size={16} className={styles.sivSummaryLead} />
              <span className={styles.sivSummaryTxt}>演示设置（技术详情 · 合成演示控制）</span>
              <ChevronRightIcon size={16} className={styles.sivChevron} />
            </summary>
            <div className={styles.sivDetailsBody}>
              <p className={styles.sivNote}>
                会话 {session?.sessionId.slice(0, 12)}… · 项目 {session?.projectId} · 远端 v{remoteVersion} · 视频 {session?.video.state}（provider: {session?.video.provider}）
              </p>
              <div className={styles.sivBtnRow}>
                <button type="button" className={styles.sivBtnSmall} disabled={busy} onClick={() => { void runWrite('calculation', { expectedVersion: remoteVersion }, 'attempt-calculation', (data) => { setCalcResult([data.calculation as SessionDetail['calculations'][0]]); }, session?.sessionId ?? ''); }}>
                  尝试核算（未配置 → 如实显示）
                </button>
              </div>
              <ul className={styles.sivCalcList}>
                {(calcResult ?? detail?.calculations ?? []).slice(-1).reverse().map((c) => (
                  <li key={c.calcId} className={styles.sivCalcItem} data-status={c.status} data-stale={c.stale ? 'yes' : 'no'}>
                    <b>{c.status}{c.stale ? '（已过期）' : ''}</b>
                    <ul>{c.reasons.map((r, i) => <li key={i}>{r}</li>)}</ul>
                  </li>
                ))}
              </ul>
              <p className={styles.sivNote}>暂停/恢复/转人工等复核动作在下方留痕。</p>
              <ul className={styles.sivReviewLog}>
                {(detail?.reviews ?? []).slice(-4).reverse().map((r) => (
                  <li key={r.reviewId}>{REVIEW_ACTION_LABEL[r.action] ?? r.action} · 针对 v{r.targetVersion} · {r.opinion.slice(0, 26)}</li>
                ))}
              </ul>
            </div>
          </details>

          <p className={styles.sivFooter}>合成演示 · 不执行正式审批 · 视频/语音未接入如实显示 · 模型输出仅为模拟（authority=none）</p>
        </div>
      </div>

      {/* 底部常驻：补证输入 + 操作按钮 + 状态反馈（hit area≥44px） */}
      <div className={styles.sivDock}>
        {activeQuestion !== null ? (
          <>
            <div className={styles.sivDockLabelRow}>
              <label className={styles.sivFieldLabel} htmlFor="iv-answer">访谈记录（转写草稿 · 文字输入）</label>
              <button
                type="button"
                className={styles.sivVoiceBtn}
                aria-label="语音输入（未接入，点击查看说明）"
                onClick={openVoicePanel}
              >
                <MicLineIcon size={15} />
                语音 · 未接入
              </button>
            </div>
            <textarea
              id="iv-answer"
              className={styles.sivTextarea}
              value={answer}
              rows={2}
              maxLength={2000}
              placeholder="记录实控人现场说明要点（合成演示）…"
              onChange={(e) => {
                setAnswer(e.target.value);
                answerRevisionRef.current += 1;
                try { window.sessionStorage.setItem('jw:v5-preview:draft:answer', e.target.value); } catch { /* 忽略 */ }
              }}
            />
            <p className={styles.sivFieldLabel}>关键字段核对（人工纠正，非模型结论）</p>
            <div className={styles.sivFields}>
              <label className={styles.sivField}>
                设备数量（台）
                <input
                  className={styles.sivInput}
                  inputMode="numeric" value={fields.deviceCount}
                  placeholder="待口述确认"
                  onChange={(e) => { setFields((p) => ({ ...p, deviceCount: e.target.value })); answerRevisionRef.current += 1; }}
                />
              </label>
              <label className={styles.sivField}>
                报价（万元）
                <input
                  className={styles.sivInput}
                  inputMode="decimal" value={fields.quote}
                  placeholder="待口述确认"
                  onChange={(e) => { setFields((p) => ({ ...p, quote: e.target.value })); answerRevisionRef.current += 1; }}
                />
              </label>
            </div>
            <div className={styles.sivActions}>
              <button
                type="button"
                className={styles.sivPrimary}
                disabled={busy || activeQuestion === null || answer.trim() === ''}
                onClick={submitInterviewRecord}
              >
                {busy ? '提交中…' : '提交访谈记录'}
              </button>
              <button
                type="button"
                className={styles.sivSecondary}
                disabled={busy || paused}
                title={paused ? '本轮已处于暂停状态' : undefined}
                onClick={pauseRound}
              >
                暂停本轮
              </button>
              {paused ? (
                <button
                  type="button"
                  className={styles.sivSecondary}
                  disabled={busy}
                  onClick={resumeRound}
                >
                  恢复本轮
                </button>
              ) : null}
              <button
                type="button"
                className={styles.sivSecondary}
                disabled={busy || paused}
                title={paused ? '本轮判断已暂停：转人工被服务端阻断（补证/纠正仍可用）' : undefined}
                onClick={escalateHuman}
              >
                转人工
              </button>
            </div>
          </>
        ) : (
          <>
            <div className={styles.sivDockLabelRow}>
              <label className={styles.sivFieldLabel} htmlFor="iv-ask">业务发起关键问题（绑定现场证据）</label>
            </div>
            <textarea
              id="iv-ask"
              className={styles.sivTextarea}
              value={askDraft}
              rows={2}
              maxLength={2000}
              placeholder="例：请说明照片区块中设备的现状与数量（合成演示）…"
              onChange={(e) => {
                setAskDraft(e.target.value);
                try { window.sessionStorage.setItem('jw:v5-preview:draft:ask', e.target.value); } catch { /* 忽略 */ }
              }}
            />
            <div className={styles.sivActions}>
              <button
                type="button"
                className={styles.sivPrimary}
                disabled={busy || askDraft.trim() === ''}
                onClick={() => {
                  if (session === null) return;
                  askPendingRef.current = true;
                  const ensure = detail !== null && detail.evidence.length > 0
                    ? Promise.resolve({ evidence: detail.evidence[0] })
                    : runWrite('evidence', { fixtureId: 'fixture-inspection', expectedVersion: remoteVersion }, 'attach-evidence', () => undefined, session.sessionId);
                  void Promise.resolve(ensure).then((attached) => {
                    const ev = (attached as { evidence?: { evidenceId: string; version: number } }).evidence;
                    const fresh = ev !== undefined ? ev : null;
                    // runWrite 内部已刷新 detail；从刷新后的远端取最新证据
                    return getRemote<SessionDetail>(`detail?sessionId=${session.sessionId}`).then((d) => {
                      const latest = d.evidence[d.evidence.length - 1];
                      void fresh;
                      return runWrite('annotations', {
                        evidenceId: latest.evidenceId,
                        evidenceVersion: latest.version,
                        question: askDraft.trim(),
                        rect: { x: 0, y: 0, w: 1, h: 1 },
                        expectedVersion: d.remoteVersion,
                      }, 'annotation', () => { setAskDraft(''); askPendingRef.current = false; setNotice('关键问题已发起（绑定现场证据）'); }, session.sessionId);
                    });
                  }).catch(() => { askPendingRef.current = false; });
                }}
              >
                发起关键问题
              </button>
            </div>
          </>
        )}
        {paused || notice !== null || writeError !== null ? (
          <div className={styles.sivFeedback}>
            {paused ? <p className={styles.sivNote} role="status">本轮判断已暂停：模型推进与确认类动作被服务端阻断；补证/纠正仍可用。</p> : null}
            {notice !== null ? <p className={styles.sivNotice} role="status">{notice}</p> : null}
            {writeError !== null ? <p className={styles.sivError} role="alert">{writeError}</p> : null}
          </div>
        ) : null}
      </div>

      {/* 访谈全屏（模拟视图）：顶部阶段/建议 → 中部画面位（诚实未接入）→ 底部转写+时间戳可回看 + 左翻转/中挂断/右拍照。 */}
      {fullscreen ? (
        <div className={styles.sivFull} role="dialog" aria-label="全屏访谈（模拟画面）">
          <header className={styles.sivFullTop}>
            <span className={styles.sivTopChip} data-state={paused ? 'paused' : 'live'}>
              {paused ? <WarnIcon size={13} className={styles.sivChipIcon} /> : <span className={styles.sivDot} aria-hidden="true" />}
              {paused ? '已暂停' : '访谈中'}
            </span>
            <span className={styles.sivFullHint}>
              {activeQuestion !== null ? `当前问题：${activeQuestion.question.slice(0, 26)}…` : '当前待办：补充设备清单'}
            </span>
            <span className={styles.sivFullSuggest}>建议追问（模拟）：设备检修计划与书面确认</span>
          </header>
          <div className={styles.sivFullStage}>
            <span className={styles.sivFullAvatar}>{simulationOn ? '实控人（合成头像位）' : '实控人画面位'}</span>
            <span className={styles.sivSimTag}>{simulationOn ? '模拟会议视图 · 非真实画面' : '视频未接入 · 模拟视图（不申请摄像头/麦克风）'}</span>
          </div>
          <div className={styles.sivFullTranscript} aria-label="转写记录（合成事件，可回看）">
            <p className={styles.sivTranscriptTitle}>实时转写（合成事件 · 非真实 ASR · 可回看）</p>
            <ul className={styles.sivTranscriptList}>
              {transcript.length === 0 ? <li className={styles.sivNote}>暂无转写事件；可在退出全屏后添加合成转写演示事件。</li> : null}
              {transcript.slice().reverse().map((t, i) => (
                <li key={`${t.at}-${i}`} className={styles.sivTranscriptItem}>
                  <time className={styles.sivTranscriptTime}>{t.at}</time>
                  <span className={styles.sivTranscriptWho}>{t.who}</span>
                  <span className={styles.sivTranscriptText}>{t.text}</span>
                </li>
              ))}
            </ul>
          </div>
          {flipNote !== null ? <p className={styles.sivFullFlipNote} role="status">{flipNote}</p> : null}
          <div className={styles.sivFullControls}>
            <button
              type="button"
              className={styles.sivFullBtn}
              title="视频未接入：无轨道可翻转"
              onClick={() => setFlipNote('视频未接入：没有可翻转的摄像头轨道（合成演示）。')}
            >
              <span aria-hidden="true">⟲</span>
              翻转
            </button>
            <button type="button" className={styles.sivFullHangup} onClick={() => { setFullscreen(false); setNotice('已退出全屏访谈（模拟视图关闭，无真实通话）。'); }}>
              <span aria-hidden="true">◉</span>
              挂断
            </button>
            <button
              type="button"
              className={styles.sivFullBtn}
              onClick={() => { setFullscreen(false); setNotice('已退出全屏；请使用"证据与本地拍照"面板的拍照/选图入口（本地预览，尚未入库）。'); }}
            >
              <span aria-hidden="true">◉</span>
              拍照
            </button>
          </div>
        </div>
      ) : null}
    </div>
  );
}

const REVIEW_ACTION_LABEL: Record<string, string> = {
  confirm: '确认可见内容', correct: '纠正', request_resupply: '要求补充',
  request_retake: '要求重拍', pause_round: '暂停本轮判断', resume_round: '恢复本轮', escalate_human: '转人工',
};
