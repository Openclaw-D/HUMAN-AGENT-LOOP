    "cmd": null,
    "args": [],
    "cwd": "../C",
    "port": 17930,
    "optional": true
  },
  "principal": {
    "$comment": "A契约声明的身份头/令牌方案；合成principal，非真实凭据",
    "headerName": "x-principal-token",
    "admin": "v7d-synthetic-admin",
    "user1": "v7d-synthetic-p1",
    "user2": "v7d-synthetic-p2"
  },
  "pg": { "port": 15432, "runDir": ".run/pg-sut", "dbname": "v7d_sut" },
  "modelConfigured": false
