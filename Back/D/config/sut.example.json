{
  "$comment": "D路SUT配置模板。A发布固定版本后复制为 sut.json 并按A的README填写真实命令。${D_PG_DSN} 由sutctl替换为D自有PG的DSN。",
  "contractPath": "../CONTRACT.md",
  "contractSha256": "待A发布后填",
  "api": {
    "cmd": "node",
    "args": ["server.mjs"],
    "cwd": "../A",
    "env": { "PORT": "17910", "DATABASE_URL": "${D_PG_DSN}" },
    "port": 17910,
    "healthPath": "/healthz",
    "healthTimeoutMs": 60000
  },
  "migrations": {
    "$comment": "可省略则置null；A的schema初始化命令",
    "cmd": null,
    "args": [],
