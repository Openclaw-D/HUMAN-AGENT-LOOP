    "env": { "DATABASE_URL": "${D_PG_DSN}" }
  },
  "worker": {
    "cmd": null,
    "args": [],
    "cwd": "../B",
    "env": { "DATABASE_URL": "${D_PG_DSN}", "MODEL_ENDPOINT": "http://127.0.0.1:17930", "MODEL_MOCK": "off" },
    "optional": true
  },
  "fakeApi": {
