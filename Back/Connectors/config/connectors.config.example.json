    "allowRealWecom": false,
    "corpid": "REPLACE_corpid",
    "archiveSecret": "REPLACE_msgaudit_secret",
    "callbackToken": "REPLACE_callback_token",
    "encodingAESKey": "REPLACE_43_CHAR_ENCODING_AES_KEY"
  },
  "trtc": { "callbackKey": "REPLACE_trtc_callback_key", "allowRealTrtc": false },
  "a": {
    "baseUrl": "http://127.0.0.1:48080",
    "credential": "tok-business",
    "tenantId": "tenant_demo",
    "bridge": true,
    "credentials": {
      "service": "REPLACE_kind_service_principal_token（analysis-runs/Gate回执/findings 专用）",
      "registrar": "REPLACE_human_business_token（派生解析工件/包域结果登记）",
      "reviewer": "REPLACE_human_business_token（人工复核回写）",
      "upload": { "customer_owner": "REPLACE_客户角色principal_token", "customer_finance": "REPLACE_...", "customer_worker": "REPLACE_..." },
      "uploadFallback": "REPLACE_缺省上传者token"
    },
