    "timeoutMs": 5000
  },
  "processing": {
    "driverIntervalMs": 2000,
    "concurrency": 2,
    "maxTasksPerCustomerPerHour": null,
    "outboundPolicy": "suggest_only",
    "aPackageDomainResults": false,
    "aCustomerLinks": { "cust-demo-1": { "aCustomerId": "cust_xxx（A v2 客户ID）", "projectId": "proj_xxx（可选，v1 项目）" } },
    "_note": "processing.aCustomerLinks 种子现经 start-connectors 透传（IR-03-8⑤）；缺省时兼容 a.customerLinks。种子仅首次落 a_customer_links，表为权威；生产须来自授权客户目录，不由材料推断"
  }
}
