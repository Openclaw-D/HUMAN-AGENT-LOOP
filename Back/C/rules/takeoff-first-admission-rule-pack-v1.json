    {
      "ruleId": "SIM-LEASEBACK-BASIS-01",
      "version": 1,
      "name": "回租标的净值声明缺失或非正（合成门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "sale_leaseback"
        ],
