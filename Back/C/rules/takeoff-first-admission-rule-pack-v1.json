      "condition": {
        "fact": "top1_customer_revenue_share",
        "op": "gt",
        "value": 80
      },
      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility"
        ]
      },
      "nonWaivable": false,
      "review": {
        "role": "credit_reviewer",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-MATERIAL-FRESHNESS-01",
      "version": 1,
