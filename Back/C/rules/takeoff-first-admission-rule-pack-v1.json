    {
      "ruleId": "SIM-LITIGATION-PENDING-01",
      "version": 1,
      "name": "存在未决诉讼声明且无解除证据（合成硬门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "sale_leaseback",
          "direct_lease"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://litigation-pending-takeoff-v1",
        "note": "合成演示：未决诉讼声明（declared级即触发评估）→ 阻断正面确认；解除只能由诉讼解除证据（核验）后重算，无通用强制放行"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "litigation_pending_declared",
