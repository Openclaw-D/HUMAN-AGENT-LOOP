{
  "rulePackId": "jw-takeoff-first-admission-rule-pack",
  "version": "1.0.0",
  "createdAt": "2026-09-20",
  "boundary": "simulation_only",
  "boundaryNote": "本包全部为显式 simulation_rule 合成演示规则与合成期限/价格口径，不冒充任何机构制度；真实政策接入须治理流程批准并扩展 sourceRef.kind。TAKEOFF-FA-1.0.0 首次回租准入预评估专用：终点为有权人员确认预评估结论，本包硬门只阻断正面确认与正式动作，不产生任何授信效力。机构类型区分：商业融资租赁(commercial_leasing) ≠ 金融租赁公司(financial_leasing)。",
  "activation": {
    "note": "approvalStatus 必须为 approved 且在生效窗口内且来源可确认才激活为正式硬门；否则按 policy_pending 透出，不放行也不阻断",
    "historyReplay": "规则文件不可变；改版=新版本文件；历史回放=用旧版本文件+当时 asOf 重放"
  },
  "exceptionPolicy": {
    "approved": false,
    "note": "未批准任何例外政策：attemptWaiver 一律拒绝，无通用强制放行接口"
  },
  "businessThresholds": {
    "version": "sim-business@0.3",
    "thresholds": [
      {
        "key": "sim_min_cash_coverage",
        "value": 1.0,
        "unit": "倍(x)",
        "source": "simulation://cash-coverage-demo",
        "note": "演示值：与 SIM-CASH-COVERAGE-01 同源；真实阈值须公司批准"
      },
      {
        "key": "sim_top1_concentration_max",
        "value": 80,
        "unit": "%",
        "source": "simulation://concentration-demo"
      }
    ]
  },
  "systemThresholds": {
    "version": "sim-system@0.1",
    "thresholds": [
      {
        "key": "model_timeout",
        "value": 30000,
        "unit": "ms",
        "source": "config://b-worker-defaults"
      },
      {
        "key": "budget_exhausted",
        "value": 1,
        "unit": "boolean",
        "source": "config://budget"
      },
      {
        "key": "recording_unhealthy",
        "value": 1,
        "unit": "boolean",
        "source": "config://recorder"
      }
    ]
  },
  "productCap": {
    "value": 10000000,
    "currency": "CNY",
    "source": "user://demo-product-cap@2026-09-16",
    "note": "用户提出的产品上限（1,000 万）：非监管限额、非默认批准金额"
  },
  "termPolicy": {
    "defaultMonths": 36,
    "minMonths": 12,
    "maxMonths": 60,
    "unit": "month",
    "basis": "合成演示期限政策：默认36期、可夹取12–60期；非机构制度，正式期限由人工确认",
    "source": "simulation://term-policy-takeoff-v1"
  },
  "pricePolicy": {
    "referenceRateAnnual": 0.08,
    "caliber": "含息平均月租（合成名义口径）",
    "basis": "合成演示参考价格：名义年利率8%摊入平均月租，仅作候选参考口径；非报价、非机构定价",
    "source": "simulation://price-policy-takeoff-v1"
  },
  "rules": [
    {
      "ruleId": "SIM-ASSET-OWNERSHIP-01",
      "version": 1,
      "name": "租赁物权属经核验属第三方（合成硬门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "direct_lease",
          "sale_leaseback"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://asset-ownership-demo-v1",
        "note": "合成演示：权属文件证明非客户所有 → 阻断授信与放款"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "equipment_ownership_verified",
          "minLevel": "verified"
        }
      ],
      "condition": {
        "fact": "equipment_ownership_verified",
        "op": "is_false"
      },
      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility",
          "disburse"
        ]
      },
      "nonWaivable": true,
      "review": {
        "role": "asset_reviewer",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-ENTITY-IDENTITY-01",
      "version": 1,
      "name": "主体身份经核验不匹配（合成硬门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "*"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://entity-identity-demo-v1",
        "note": "合成演示：身份核验确认主体不符 → 阻断"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "entity_identity_verified",
          "minLevel": "verified"
        }
      ],
      "condition": {
        "fact": "entity_identity_verified",
        "op": "is_false"
      },
      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility",
          "disburse",
          "sign_contract"
        ]
      },
      "nonWaivable": true,
      "review": {
        "role": "compliance_reviewer",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-CASH-COVERAGE-01",
      "version": 1,
      "name": "现金流覆盖率低于演示下限（可复核门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "direct_lease",
          "sale_leaseback"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://cash-coverage-demo-v1",
        "note": "合成演示阈值 1.0（无单位比值），非公司制度；命中 → HOLD 人工复核（可豁免=false：非不可豁免，但本环境无例外政策，仍无放行接口）"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "monthly_operating_cash_flow",
          "minLevel": "source_supported"
        },
        {
          "factKey": "monthly_debt_service",
          "minLevel": "source_supported"
        }
      ],
      "condition": {
        "fact": "cash_coverage_ratio",
        "op": "lt",
        "value": 1.0
      },
      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility"
        ]
      },
      "nonWaivable": false,
      "review": {
        "role": "credit_reviewer",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-CASH-COVERAGE-STRESSED-01",
      "version": 1,
      "name": "叠加声明新增债务后覆盖率低于演示下限（压力门）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "direct_lease",
          "sale_leaseback"
