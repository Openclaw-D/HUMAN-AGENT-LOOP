      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://cash-coverage-stressed-demo-v1",
        "note": "合成演示：派生事实 cash_coverage_ratio_stressed = 现金流/(偿债+声明新增债务)；新增负债使材料更齐不抵消风险（C07）"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "monthly_operating_cash_flow",
          "minLevel": "source_supported"
        },
        {
          "factKey": "monthly_debt_service",
          "minLevel": "source_supported"
        }
      ],
      "condition": {
        "fact": "cash_coverage_ratio_stressed",
        "op": "lt",
        "value": 1.0
      },
      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility"
        ]
      },
      "nonWaivable": false,
      "review": {
        "role": "credit_reviewer",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-CUSTOMER-CONCENTRATION-01",
      "version": 1,
      "name": "第一大客户收入占比超演示上限（主包为 approved；C28 场景经 packOverride 置 pending 演示）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "*"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceRef": {
        "kind": "simulation_rule",
        "id": "sim://concentration-demo-v1",
        "note": "合成演示：上限 80%（演示值）；C28 用 packOverride 将本规则置 approvalStatus=pending_approval 演示 policy_pending"
      },
      "approvalStatus": "approved",
      "requiredFacts": [
        {
          "factKey": "top1_customer_revenue_share",
          "minLevel": "source_supported"
        }
