      "effect": {
        "kind": "hard_block",
        "blockedActions": [
          "approve_facility"
        ]
      },
      "nonWaivable": false,
      "review": {
        "role": "business",
        "escalateRole": "risk_committee"
      },
      "alternativeVersions": []
    },
    {
      "ruleId": "SIM-LEASE-REGISTER-01",
      "version": 1,
      "name": "租赁物未办理登记（已过期规则：生效窗口演示）",
      "scope": {
        "orgTypes": [
          "commercial_leasing"
        ],
        "regions": [
          "*"
        ],
        "products": [
          "*"
        ],
        "customerRange": "*"
      },
      "effectiveFrom": "2025-01-01",
