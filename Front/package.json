{
  "name": "human-decision-simulator-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config preview/vite.config.mjs",
    "build": "node ../scripts/write-notices.mjs && vite build --config preview/vite.config.mjs",
    "typecheck": "tsc --noEmit -p preview/tsconfig.json",
    "test": "node --import ./test/setup.mjs --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
