{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUnusedLocals": true,
    "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": []
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
